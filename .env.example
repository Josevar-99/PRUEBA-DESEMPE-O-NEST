# ==============================================================================
# Workshop API environment variables
# Copy to .env with: cp .env.example .env
# All variables are validated with Zod at startup (src/config/env.schema.ts)
# ==============================================================================

# Environment: development | production | test
NODE_ENV=development

# Server port (main.ts and docker-compose)
PORT=3000

# Global route prefix: http://localhost:3000/api/...
API_PREFIX=api

# ==============================================================================
# PostgreSQL (must match docker-compose.yml)
# Use localhost when the app runs on your machine, or db inside Docker Compose
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller_db

# ==============================================================================
# JWT authentication
# ==============================================================================
# At least 32 characters. Use your own value outside development
JWT_SECRET=replace-this-with-a-secret-of-at-least-32-characters

# Token lifetime (15m, 1h, 1d). Use 30s to test the expired-token case
JWT_EXPIRES_IN=1h

# ==============================================================================
# External integrations
# ==============================================================================
# Sent in the x-api-key header; at least 16 characters
API_KEY=fake-integration-key-123456