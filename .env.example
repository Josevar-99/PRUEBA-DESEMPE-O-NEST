# ==============================================================================
# 💡 [ADAPTAR PARA LA PRUEBA - VARIABLES DE ENTORNO]:
# Copia este archivo a .env con: cp .env.example .env
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Puerto del servidor (main.ts y docker-compose)
# 💡 Si el puerto 3000 está ocupado en tu máquina, cámbialo a 3001, 3002, 4000, etc.
PORT=3000
APP_PORT=3000

# Prefijo global de rutas (ej: api o api/v1)
API_PREFIX=api

# ==============================================================================
# CONFIGURACIÓN DE POSTGRESQL (Debe coincidir con docker-compose.yml)
# ==============================================================================
# 💡 Si ejecutas la app localmente contra docker: usa 'localhost'
# 💡 Si ejecutas la app dentro de docker-compose: usa 'db'
POSTGRES_HOST=localhost

# 💡 Si el puerto 5432 del host está ocupado por otro Postgres, cámbialo aquí y en docker-compose
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=performance_db

# ==============================================================================
# AUTENTICACIÓN JWT
# ==============================================================================
# 💡 Clave secreta para firmar tokens. En producción o evaluación, usa una clave segura
JWT_SECRET=super_secret_jwt_key_for_performance_test_12345

# 💡 Tiempo de expiración del token (ejemplos: '15m', '1h', '1d', '7d')
JWT_EXPIRES_IN=1d

