# ==============================================================================
# Variables de entorno de Taller API
# Copiar a .env con: cp .env.example .env
# Todas se validan con Zod al arrancar (src/config/env.schema.ts)
# ==============================================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor (main.ts y docker-compose)
PORT=3000

# Prefijo global de rutas: http://localhost:3000/api/...
API_PREFIX=api

# ==============================================================================
# PostgreSQL (debe coincidir con docker-compose.yml)
# localhost si la app corre en tu máquina; db si corre dentro de docker-compose
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller_db

# ==============================================================================
# Autenticación JWT
# ==============================================================================
# Mínimo 32 caracteres. Cambiar por un valor propio fuera de desarrollo
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres

# Expiración del token (15m, 1h, 1d). Usar 30s para probar el caso "token expirado"
JWT_EXPIRES_IN=1h

# ==============================================================================
# Integraciones externas
# ==============================================================================
# Se envía en el header x-api-key; mínimo 16 caracteres
API_KEY=clave-ficticia-de-integracion-123